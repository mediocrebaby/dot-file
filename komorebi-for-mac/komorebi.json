{
  "$schema": "https://komorebi-for-mac.lgug2z.com/komorebi.0.1.1.schema.json",
  "app_specific_configuration_path": "$HOME/.config/komorebi/applications.json",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 5,
  "default_container_padding": 5,
  "global_work_area_offset": {
    "left": 0,
    "top": 37,
    "right": 0,
    "bottom": 37
  },
  "animation": {
    "enabled": true,
    "duration": 200,
    "fps": 160,
    "style": {
        "movement":"EaseOutBack"
    }
  },
  "border": true,
  "border_width": 6,
  "border_offset": -3,
  "border_radius": 17,
  "floating_window_aspect_ratio": "Widescreen",
  "floating_layer_behaviour": "Float",
  "resize_delta": 100,
  "ignore_rules": [],
  "floating_applications": [],
  "manage_rules": [],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "Monitor 1, Workspace 1",
          "layout": "Grid"
        },
        {
          "name": "Monitor 1, Workspace 2",
          "layout": "Grid"
        },
        {
          "name": "Monitor 1, Workspace 3",
          "layout": "Grid"
        }
      ]
    }
  ]
}
