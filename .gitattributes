# 默认：自动识别文本/二进制，文本统一以 LF 入库（跨平台 dotfiles 标准做法）
* text=auto eol=lf

# 显式文本类型，强制 LF，避免多机间因换行符产生 diff
*.lua    text eol=lf
*.toml   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制资源，禁止换行符/diff 处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
